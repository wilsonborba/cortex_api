# Cortex Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Database configuration (defaults to SQLite local)
CORTEX_DATABASE_URL=sqlite:///var/cortex.db

# Service endpoints
CORTEX_OLLAMA_BASE_URL=http://localhost:11434
CORTEX_HIPPOCAMPUS_URL=http://localhost:8001

# Model Registry: provider discovery
CORTEX_DISCOVERY_TIMEOUT_SECONDS=10
CORTEX_AGY_COMMAND=agy
CORTEX_CLAUDE_CREDENTIALS_PATH=~/.claude/.credentials.json
CORTEX_CODEX_AUTH_PATH=~/.codex/auth.json

# Execution drivers (Quota Tracker)
CORTEX_CLAUDE_DOCKER_COMMAND=claude-docker
CORTEX_AGY_DOCKER_COMMAND=agy-docker
CORTEX_CODEX_COMMAND=codex
CORTEX_DRIVER_TIMEOUT_SECONDS=180

# Quota Tracker: sliding window token budget per provider (tune to your real
# plan limits; ollama is local/free and always reports full quota)
CORTEX_DEFAULT_QUOTA_WINDOW_TOKENS=1000000
CORTEX_QUOTA_WINDOW_TOKENS_BY_PROVIDER={}
CORTEX_COOLDOWN_MINUTES=15

# Logging
CORTEX_LOG_LEVEL=INFO
CORTEX_LOG_FILE=var/cortex.log

# Environment (development, test, production)
CORTEX_ENVIRONMENT=development

# API Secrets (keep only in .env, never commit)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
