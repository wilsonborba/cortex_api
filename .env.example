# Cortex environment overrides and secrets
# Defaults for non-secret runtime behavior live in lib/core/settings.py.
# Only add values here when you need a secret, a machine-specific path, or an explicit override.

# Optional deployment overrides
# Cortex defaults to 0.0.0.0.
# CORTEX_API_HOST=127.0.0.1
# Cortex defaults to 8003. The installer only writes this when it must use a different port.
# CORTEX_API_PORT=8005
# Cortex defaults to sqlite:///var/cortex.db.
# CORTEX_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/cortex
# Cortex defaults to http://localhost:11434.
# CORTEX_OLLAMA_BASE_URL=http://localhost:11434
# Cortex defaults to http://localhost:8001.
# CORTEX_HIPPOCAMPUS_URL=http://localhost:8001
# Optional when using a self-hosted SearXNG instance.
# CORTEX_SEARXNG_BASE_URL=http://localhost:8080
# Optional when overriding the default runtime mode.
# CORTEX_ENVIRONMENT=production
# Optional when overriding the default install profile.
# CORTEX_PROFILE=light

# Machine-specific paths and commands
# Uncomment only if your local paths differ from Cortex defaults or PATH resolution.
# CORTEX_CLAUDE_CREDENTIALS_PATH=/home/your-user/.claude/.credentials.json
# CORTEX_CODEX_AUTH_PATH=/home/your-user/.codex/auth.json
# CORTEX_AGY_COMMAND=/home/your-user/.local/bin/agy
# CORTEX_CLAUDE_COMMAND=/home/your-user/.local/bin/claude
# CORTEX_CODEX_COMMAND=/home/your-user/.local/bin/codex
# Optional disable list for normal provider usage.
# CORTEX_DISABLED_PROVIDERS=claude

# Required only when the target service needs auth.
# CORTEX_HIPPOCAMPUS_API_KEY=

# Provider credentials (configure only the providers you actually use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
CORTEX_GROQ_API_KEY=
CORTEX_GOOGLE_AI_STUDIO_API_KEY=
CORTEX_OPENROUTER_API_KEY=
CORTEX_CLOUDFLARE_API_KEY=
CORTEX_CLOUDFLARE_ACCOUNT_ID=
CORTEX_COHERE_API_KEY=
CORTEX_MISTRAL_API_KEY=
CORTEX_NVIDIA_API_KEY=
CORTEX_ZAI_API_KEY=
CORTEX_REQUESTY_API_KEY=
CORTEX_HUGGINGFACE_API_KEY=
CORTEX_OLLAMA_CLOUD_API_KEY=
CORTEX_AION_LABS_API_KEY=
CORTEX_SILICONFLOW_API_KEY=
CORTEX_INFERENCE_NET_API_KEY=
CORTEX_SAMBANOVA_API_KEY=
