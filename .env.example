# Cortex Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Database configuration (defaults to SQLite local)
CORTEX_DATABASE_URL=sqlite:///var/cortex.db

# Service endpoints
CORTEX_OLLAMA_BASE_URL=http://localhost:11434
CORTEX_HIPPOCAMPUS_URL=http://localhost:8001

# API server bind address. Port 8000 collides with other local services
# (e.g. kgcb-api) -- keep this on 8003 unless you have verified 8000 is free.
CORTEX_API_HOST=127.0.0.1
CORTEX_API_PORT=8003

# Model Registry: provider discovery
CORTEX_DISCOVERY_TIMEOUT_SECONDS=10
CORTEX_AGY_COMMAND=agy
CORTEX_CLAUDE_CREDENTIALS_PATH=~/.claude/.credentials.json
CORTEX_CODEX_AUTH_PATH=~/.codex/auth.json

# Execution drivers (Quota Tracker)
CORTEX_CLAUDE_DOCKER_COMMAND=claude-docker
CORTEX_AGY_DOCKER_COMMAND=agy-docker
CORTEX_CODEX_COMMAND=codex
CORTEX_DRIVER_TIMEOUT_SECONDS=180

# Quota Tracker: sliding window token budget per provider (tune to your real
# plan limits; ollama is local/free and always reports full quota)
CORTEX_DEFAULT_QUOTA_WINDOW_TOKENS=1000000
CORTEX_QUOTA_WINDOW_TOKENS_BY_PROVIDER={}
CORTEX_COOLDOWN_MINUTES=15

# Web Retrieval: search + scraping
CORTEX_WEB_SEARCH_MAX_RESULTS=5
CORTEX_WEB_RETRIEVAL_TIMEOUT_SECONDS=15
# Optional: only used if set (self-hosted SearXNG instance)
CORTEX_SEARXNG_BASE_URL=

# Hippocampus: external memory/document service client
CORTEX_HIPPOCAMPUS_TIMEOUT_SECONDS=10
# Optional: only sent as a Bearer token if set (hippocampus's auth is
# disabled entirely when its own api_keys config is empty, e.g. local/LAN)
CORTEX_HIPPOCAMPUS_API_KEY=

# Routing Engine: dynamic scoring weights + quota cutoff
CORTEX_QUOTA_CRITICAL_THRESHOLD=0.15
CORTEX_ROUTING_WEIGHT_CAPABILITY=0.5
CORTEX_ROUTING_WEIGHT_QUOTA=0.25
CORTEX_ROUTING_WEIGHT_LATENCY=0.15
CORTEX_ROUTING_WEIGHT_COST=0.10
CORTEX_ROUTING_COST_CEILING_USD_PER_MILLION=20

# Execution Engine
CORTEX_EXECUTOR_MAX_RETRIES=1
CORTEX_EXECUTOR_MAX_REROUTES=1
CORTEX_EXECUTOR_MAX_CRITIC_REVISIONS=1

# REST API
CORTEX_CORS_ALLOW_ORIGINS=["*"]
CORTEX_API_SYNC_MODELS_ON_STARTUP=true
CORTEX_API_BACKGROUND_TASKS_ENABLED=true
CORTEX_API_COOLDOWN_REFRESH_INTERVAL_SECONDS=60

# Logging
CORTEX_LOG_LEVEL=INFO
CORTEX_LOG_FILE=var/cortex.log

# Environment (development, test, production)
CORTEX_ENVIRONMENT=development

# API Secrets (keep only in .env, never commit)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Free-tier providers (docs/free-tier-adapters-plan.md). Real values come
# from docs/providers_api_keys.txt (local, gitignored). Note
# CORTEX_GOOGLE_AI_STUDIO_API_KEY is deliberately separate from the
# GOOGLE_API_KEY above.
CORTEX_GROQ_API_KEY=
CORTEX_GOOGLE_AI_STUDIO_API_KEY=
CORTEX_OPENROUTER_API_KEY=
CORTEX_CLOUDFLARE_API_KEY=
CORTEX_CLOUDFLARE_ACCOUNT_ID=
CORTEX_COHERE_API_KEY=
CORTEX_MISTRAL_API_KEY=
CORTEX_NVIDIA_API_KEY=
CORTEX_ZAI_API_KEY=
CORTEX_REQUESTY_API_KEY=
CORTEX_HUGGINGFACE_API_KEY=
CORTEX_OLLAMA_CLOUD_API_KEY=
CORTEX_AION_LABS_API_KEY=
CORTEX_SILICONFLOW_API_KEY=
CORTEX_INFERENCE_NET_API_KEY=
CORTEX_SAMBANOVA_API_KEY=
